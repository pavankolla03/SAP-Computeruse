{"id": "error-401", "document_type": "error_playbook", "collection": "mpl_errors", "sap_product": "Integration Suite", "sap_module": "Cloud Integration", "topic": "401 Authentication failure", "title": "401 Authentication failure", "content": "Inspect the receiver credential alias, OAuth token endpoint, scopes and service user authorization. Do not rotate credentials automatically. Re-run a controlled test only after an approved configuration change.", "source": "internal:curated-v1", "source_version": "1", "source_date": null, "retrieved_at": "2026-10-08T18:26:13.109667+00:00", "tenant_scope": "global", "customer_scope": "global", "security_classification": "public", "tags": [], "applicable_actions": ["QUERY_MPL", "DIAGNOSE_ERROR"], "applicable_errors": ["401"], "artifact_types": [], "embedding_version": "", "hash": "94220b461f4e53fb3da69be811b90e50094ccf8531e3d3d59faa264c12e69fb0", "facts": {}, "approved": true, "license": "internal-original", "provenance_kind": "original"}
{"id": "error-403", "document_type": "error_playbook", "collection": "mpl_errors", "sap_product": "Integration Suite", "sap_module": "Cloud Integration", "topic": "403 Authorization failure", "title": "403 Authorization failure", "content": "Verify service permissions, tenant roles and resource scope. A valid token does not imply access. Escalate missing permissions rather than repeatedly retrying.", "source": "internal:curated-v1", "source_version": "1", "source_date": null, "retrieved_at": "2026-10-08T18:26:13.109745+00:00", "tenant_scope": "global", "customer_scope": "global", "security_classification": "public", "tags": [], "applicable_actions": ["QUERY_MPL", "DIAGNOSE_ERROR"], "applicable_errors": ["403"], "artifact_types": [], "embedding_version": "", "hash": "7221a852b9eaff5483658d84c712d120ea17f9a4ef1dd8906c8aa9768fc9e3fe", "facts": {}, "approved": true, "license": "internal-original", "provenance_kind": "original"}
{"id": "error-404", "document_type": "error_playbook", "collection": "mpl_errors", "sap_product": "Integration Suite", "sap_module": "Cloud Integration", "topic": "404 Resource not found", "title": "404 Resource not found", "content": "Check endpoint path, service version, entity name and artifact identity. Confirm the intended resource exists before changing configuration.", "source": "internal:curated-v1", "source_version": "1", "source_date": null, "retrieved_at": "2026-10-08T18:26:13.109753+00:00", "tenant_scope": "global", "customer_scope": "global", "security_classification": "public", "tags": [], "applicable_actions": ["QUERY_MPL", "DIAGNOSE_ERROR"], "applicable_errors": ["404"], "artifact_types": [], "embedding_version": "", "hash": "7f22f6c764eff749a5abd61010d08a4deefad5123d13ee7d1cf1b6500050ada2", "facts": {}, "approved": true, "license": "internal-original", "provenance_kind": "original"}
{"id": "error-429", "document_type": "error_playbook", "collection": "mpl_errors", "sap_product": "Integration Suite", "sap_module": "Cloud Integration", "topic": "429 Rate limited", "title": "429 Rate limited", "content": "Read Retry-After, reduce concurrency and retry only safe idempotent requests within the task budget. Do not repeat an uncertain write.", "source": "internal:curated-v1", "source_version": "1", "source_date": null, "retrieved_at": "2026-10-08T18:26:13.109761+00:00", "tenant_scope": "global", "customer_scope": "global", "security_classification": "public", "tags": [], "applicable_actions": ["QUERY_MPL", "DIAGNOSE_ERROR"], "applicable_errors": ["429"], "artifact_types": [], "embedding_version": "", "hash": "bed875c08ab9c4d587c1fd5a1652cb0c57157e844f113b6cc7d7dddd8d6c2e85", "facts": {}, "approved": true, "license": "internal-original", "provenance_kind": "original"}
{"id": "error-500", "document_type": "error_playbook", "collection": "mpl_errors", "sap_product": "Integration Suite", "sap_module": "Cloud Integration", "topic": "500 Server error", "title": "500 Server error", "content": "Inspect the correlated MPL and downstream error body after sanitization. Distinguish configuration and payload errors from transient service failures before retrying.", "source": "internal:curated-v1", "source_version": "1", "source_date": null, "retrieved_at": "2026-10-08T18:26:13.109769+00:00", "tenant_scope": "global", "customer_scope": "global", "security_classification": "public", "tags": [], "applicable_actions": ["QUERY_MPL", "DIAGNOSE_ERROR"], "applicable_errors": ["500"], "artifact_types": [], "embedding_version": "", "hash": "c4d0e35f6027d4c6fd568f743b618b69814ee137cadd96bd5c86ce9b8679be75", "facts": {}, "approved": true, "license": "internal-original", "provenance_kind": "original"}
{"id": "error-502", "document_type": "error_playbook", "collection": "mpl_errors", "sap_product": "Integration Suite", "sap_module": "Cloud Integration", "topic": "502 Bad gateway", "title": "502 Bad gateway", "content": "Check destination reachability and upstream availability. Retry only safe operations with bounded backoff and verify the new response.", "source": "internal:curated-v1", "source_version": "1", "source_date": null, "retrieved_at": "2026-10-08T18:26:13.109776+00:00", "tenant_scope": "global", "customer_scope": "global", "security_classification": "public", "tags": [], "applicable_actions": ["QUERY_MPL", "DIAGNOSE_ERROR"], "applicable_errors": ["502"], "artifact_types": [], "embedding_version": "", "hash": "56d63c4df70e98d848731859121e7d56ac6e292eae0f3f5e725f28fb65a096fc", "facts": {}, "approved": true, "license": "internal-original", "provenance_kind": "original"}
{"id": "error-503", "document_type": "error_playbook", "collection": "mpl_errors", "sap_product": "Integration Suite", "sap_module": "Cloud Integration", "topic": "503 Temporary service unavailable", "title": "503 Temporary service unavailable", "content": "Verify destination availability and service status. A bounded retry of an idempotent test can be appropriate; verify its new correlation ID.", "source": "internal:curated-v1", "source_version": "1", "source_date": null, "retrieved_at": "2026-10-08T18:26:13.109785+00:00", "tenant_scope": "global", "customer_scope": "global", "security_classification": "public", "tags": [], "applicable_actions": ["QUERY_MPL", "DIAGNOSE_ERROR"], "applicable_errors": ["503"], "artifact_types": [], "embedding_version": "", "hash": "5ea649650905b4bf339370af509d460fba7745594193e00eba89c2ea7b4d96d3", "facts": {}, "approved": true, "license": "internal-original", "provenance_kind": "original"}
{"id": "error-timeout", "document_type": "error_playbook", "collection": "mpl_errors", "sap_product": "Integration Suite", "sap_module": "Cloud Integration", "topic": "timeout Network timeout", "title": "timeout Network timeout", "content": "Inspect endpoint reachability, Cloud Connector mapping where used, and service latency. The outcome of a timed-out write is unknown; reconcile state before retry.", "source": "internal:curated-v1", "source_version": "1", "source_date": null, "retrieved_at": "2026-10-08T18:26:13.109795+00:00", "tenant_scope": "global", "customer_scope": "global", "security_classification": "public", "tags": [], "applicable_actions": ["QUERY_MPL", "DIAGNOSE_ERROR"], "applicable_errors": ["timeout"], "artifact_types": [], "embedding_version": "", "hash": "b29223d9d8eda531c6e65f64c9a16d5adb62d97f69066e56cb604ff6fe839b34", "facts": {}, "approved": true, "license": "internal-original", "provenance_kind": "original"}
{"id": "error-unknownhostexception", "document_type": "error_playbook", "collection": "mpl_errors", "sap_product": "Integration Suite", "sap_module": "Cloud Integration", "topic": "UnknownHostException DNS resolution failure", "title": "UnknownHostException DNS resolution failure", "content": "Check destination hostname and DNS/Cloud Connector configuration; do not replace it with an unapproved endpoint.", "source": "internal:curated-v1", "source_version": "1", "source_date": null, "retrieved_at": "2026-10-08T18:26:13.109802+00:00", "tenant_scope": "global", "customer_scope": "global", "security_classification": "public", "tags": [], "applicable_actions": ["QUERY_MPL", "DIAGNOSE_ERROR"], "applicable_errors": ["UnknownHostException"], "artifact_types": [], "embedding_version": "", "hash": "a00b87fc3ae8d68c46cc04bc3de85128caf34ebcc59090510756cdb1da7bcba1", "facts": {}, "approved": true, "license": "internal-original", "provenance_kind": "original"}
{"id": "error-directvmconsumernotavailableexception", "document_type": "error_playbook", "collection": "mpl_errors", "sap_product": "Integration Suite", "sap_module": "Cloud Integration", "topic": "DirectVmConsumerNotAvailableException Missing ProcessDirect consumer", "title": "DirectVmConsumerNotAvailableException Missing ProcessDirect consumer", "content": "Check the ProcessDirect address and deployment status of the consumer flow. Verify exact address matching.", "source": "internal:curated-v1", "source_version": "1", "source_date": null, "retrieved_at": "2026-10-08T18:26:13.109809+00:00", "tenant_scope": "global", "customer_scope": "global", "security_classification": "public", "tags": [], "applicable_actions": ["QUERY_MPL", "DIAGNOSE_ERROR"], "applicable_errors": ["DirectVmConsumerNotAvailableException"], "artifact_types": [], "embedding_version": "", "hash": "27353286379dc534802eca0378587327a61fdb31f4c0e4683be18fc1925893ac", "facts": {}, "approved": true, "license": "internal-original", "provenance_kind": "original"}
{"id": "error-mapping_failure", "document_type": "error_playbook", "collection": "mpl_errors", "sap_product": "Integration Suite", "sap_module": "Cloud Integration", "topic": "mapping_failure Payload mapping failure", "title": "mapping_failure Payload mapping failure", "content": "Compare input schema and fixture with the expected mapping contract. Validate XML namespaces, XPath or JSON fields and rerun transformation assertions.", "source": "internal:curated-v1", "source_version": "1", "source_date": null, "retrieved_at": "2026-10-08T18:26:13.109816+00:00", "tenant_scope": "global", "customer_scope": "global", "security_classification": "public", "tags": [], "applicable_actions": ["QUERY_MPL", "DIAGNOSE_ERROR"], "applicable_errors": ["mapping_failure"], "artifact_types": [], "embedding_version": "", "hash": "ef504f22312fb97190839cbf715179b50aa8783be67ae73b40c946b20fafcacc", "facts": {}, "approved": true, "license": "internal-original", "provenance_kind": "original"}
{"id": "error-certificate_expiry", "document_type": "error_playbook", "collection": "mpl_errors", "sap_product": "Integration Suite", "sap_module": "Cloud Integration", "topic": "certificate_expiry Expired certificate", "title": "certificate_expiry Expired certificate", "content": "Inspect certificate metadata and approved trust configuration. Certificate rotation requires authorization and validation of dependent integrations.", "source": "internal:curated-v1", "source_version": "1", "source_date": null, "retrieved_at": "2026-10-08T18:26:13.109825+00:00", "tenant_scope": "global", "customer_scope": "global", "security_classification": "public", "tags": [], "applicable_actions": ["QUERY_MPL", "DIAGNOSE_ERROR"], "applicable_errors": ["certificate_expiry"], "artifact_types": [], "embedding_version": "", "hash": "c93ebfeafcef4f9161226c076fa417460178e047bab654c73c623db98e34189c", "facts": {}, "approved": true, "license": "internal-original", "provenance_kind": "original"}
{"id": "oauth-alias", "document_type": "text", "collection": "security", "sap_product": "Integration Suite", "sap_module": "Cloud Integration", "topic": "OAuth credential alias references", "title": "OAuth credential alias references", "content": "Use an approved credential alias rather than secret values in adapter configuration. A missing or misbound alias can cause 401 failures. Inspect metadata and verify token permissions without returning client secrets.", "source": "internal:curated-v1", "source_version": "1", "source_date": null, "retrieved_at": "2026-10-08T18:26:13.109833+00:00", "tenant_scope": "global", "customer_scope": "global", "security_classification": "public", "tags": [], "applicable_actions": [], "applicable_errors": ["401", "403"], "artifact_types": [], "embedding_version": "", "hash": "bf508e3863efa56e51541db2d63c45186acb1d211cecd8969a041d0ddf76e572", "facts": {}, "approved": true, "license": "internal-original", "provenance_kind": "original"}
{"id": "mpl-correlation", "document_type": "text", "collection": "monitoring", "sap_product": "Integration Suite", "sap_module": "Cloud Integration", "topic": "Fresh MPL correlation verifies functional completion", "title": "Fresh MPL correlation verifies functional completion", "content": "A successful deployment is not proof of message processing. Send a controlled test and capture its correlation identifier. Retrieve the corresponding fresh MPL and assert COMPLETED together with the functional response. Historical successful entries cannot validate a new run.", "source": "internal:curated-v1", "source_version": "1", "source_date": null, "retrieved_at": "2026-10-08T18:26:13.109840+00:00", "tenant_scope": "global", "customer_scope": "global", "security_classification": "public", "tags": [], "applicable_actions": ["RUN_TEST", "QUERY_MPL"], "applicable_errors": [], "artifact_types": [], "embedding_version": "", "hash": "4e4bfb007c5d949e5b60186e4c66e889b276ee67d12c7c85de7f82430e20a016", "facts": {}, "approved": true, "license": "internal-original", "provenance_kind": "original"}
{"id": "xml-mapping", "document_type": "text", "collection": "mapping", "sap_product": "Integration Suite", "sap_module": "Cloud Integration", "topic": "XML and JSON transformation fixtures", "title": "XML and JSON transformation fixtures", "content": "Define input and expected-output fixtures before deployment. Parse XML with external entity resolution disabled, check namespaces, and compare semantic output. Fail rather than deploy unvalidated generated transformations.", "source": "internal:curated-v1", "source_version": "1", "source_date": null, "retrieved_at": "2026-10-08T18:26:13.109847+00:00", "tenant_scope": "global", "customer_scope": "global", "security_classification": "public", "tags": [], "applicable_actions": [], "applicable_errors": [], "artifact_types": [], "embedding_version": "", "hash": "4a6ba019f9212371cf034ecace4c109034f6f42da8484b3ac2026d0922812ae0", "facts": {}, "approved": true, "license": "internal-original", "provenance_kind": "original"}
