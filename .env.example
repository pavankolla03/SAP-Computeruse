# SAP-CUA Environment Configuration

# Environment: sandbox | production
ENVIRONMENT=sandbox

# SAP Tenant Configuration
SAP_BASE_URL=https://<tenant>.integration.cloud.sap
SAP_API_BASE_URL=https://<tenant>.integration.cloud.sap/api/v1
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_USER=
SAP_PASSWORD=
SAP_TOKEN_ENDPOINT=https://<tenant>.integration.cloud.sap/oauth/token

# Model Configuration
MODEL_BASE_PATH=sap-cua-7b-v0
USE_VLLM=false
VLLM_GPU_MEMORY_UTILIZATION=0.9
INFERENCE_DEVICE=cpu
TORCH_DTYPE=float32

# LoRA/QLoRA Configuration
LORA_R=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
QUANTIZATION_BITS=4
USE_QLORA=true

# Training Configuration
TRAIN_BATCH_SIZE=4
EVAL_BATCH_SIZE=2
GRADIENT_ACCUMULATION_STEPS=4
LEARNING_RATE=2e-4
NUM_EPOCHS=3
WARMUP_STEPS=100
SAVE_STEPS=500
LOGGING_STEPS=10
MAX_GRAD_NORM=1.0

# DeepSpeed Configuration
DEEPSPEED_CONFIG=configs/ds_zero2.json

# Dataset Paths
DATASET_ROOT=datasets
GROUNDING_DATASET=datasets/sanitized/sap-grounding-v1
TRAJECTORY_DATASET=datasets/sanitized/sap-trajectories-v1
RECOVERY_DATASET=datasets/sanitized/sap-recovery-v1
BENCHMARK_DATASET=datasets/benchmark/sapbench-v1

# SAP Mocks (development mode)
USE_SAP_MOCKS=true
MOCK_TENANT_ID=dev-tenant-001

# Recorder
RECORDER_SCREENSHOT_DIR=datasets/raw/screenshots
RECORDER_STORAGE_BACKEND=local

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://sapcua:changeme@localhost:5432/sapcua
REDIS_URL=redis://localhost:6379/0

# Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sapcua-artifacts

# Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=sap-cua

# Cost Governance
MAX_JOB_COST_USD=50.0
COST_TRACKING_ENABLED=true

# Security
SECRET_REDACTION_ENABLED=true
AUDIT_LOG_LEVEL=INFO
DESTRUCTIVE_ACTION_REQUIRE_APPROVAL=true
