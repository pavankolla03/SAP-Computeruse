# Copy to .env. The CLI loads this file from the working directory.
# Never commit a populated .env. No SAP connection is needed for the sandbox UI.
SAP_CUA_DATA_DIR=.sap-cua
SAP_CUA_MODEL_PATH=.models/OpenCUA-7B

# Real SAP OAuth configuration: obtain from a development tenant's service key.
SAP_API_BASE_URL=
SAP_TOKEN_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=

# Optional remote OpenCUA inference (screenshots are sent to this endpoint).
SAP_CUA_INFERENCE_URL=
SAP_CUA_INFERENCE_KEY=

# Browser binary cache location, if installed outside Playwright's default cache.
# PLAYWRIGHT_BROWSERS_PATH=

# RAG V1. PostgreSQL must have the pgvector extension installed.
SAP_CUA_DATABASE_URL=
SAP_CUA_EMBEDDING_CACHE=.sap-cua/embedding-cache
SAP_CUA_CUSTOMER=local
SAP_CUA_TENANT=dev
# Docker Compose only: generate with `openssl rand -hex 24` (URL-safe).
SAP_CUA_DB_PASSWORD=
